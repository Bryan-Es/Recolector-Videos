# OAuth de Google (del archivo client_secret_*.json descargado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL de retorno tras iniciar sesión en Google.
# Local: http://localhost:8000/oauth/callback
# Producción: https://TU-DOMINIO/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# ID de la carpeta de tu Drive donde se guardarán los videos
# (lo sacas de la URL: https://drive.google.com/drive/folders/ESTE_ID)
DRIVE_FOLDER_ID=

# Puerto del servidor (para despliegue)
PORT=8000

# --- Producción ---

# Correo del dueño de la carpeta. Solo esta cuenta puede conectar con Google;
# si otra cuenta intenta conectarse, se rechaza y no se reemplaza el token.
GOOGLE_ADMIN_EMAIL=

# En contenedores efímeros (Render/Railway) el token.json en disco no persiste.
# Después de conectar una vez con OAuth, copia el refresh_token de token.json a
# esta variable; el servidor lo usará sin necesidad de disco.
GOOGLE_REFRESH_TOKEN=

# --- Seguridad (opcionales) ---

# Orígenes permitidos para CORS, separados por coma. El frontend se sirve del
# mismo servidor, así que por defecto no se permite ningún origen externo.
# Solo defínelo si sirves el frontend desde otro dominio.
# Ej: ALLOWED_ORIGINS=https://tusitio.com,https://www.tusitio.com
ALLOWED_ORIGINS=

# Marca la cookie del flujo OAuth como Secure. Pon "1" en producción (HTTPS).
COOKIE_SECURE=0

# Anti-abuso: máximo de subidas por hora por IP y subidas simultáneas.
MAX_SUBIDAS_POR_HORA=30
MAX_SUBIDAS_CONCURRENTES=3

# Tamaño máximo de video en MB (se lee en memoria).
MAX_VIDEO_MB=200
