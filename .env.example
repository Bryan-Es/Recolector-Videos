# OAuth de Google (del archivo client_secret_*.json descargado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL de retorno tras iniciar sesión en Google.
# Local: http://localhost:8000/oauth/callback
# Producción: https://TU-DOMINIO/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# ID de la carpeta de tu Drive donde se guardarán los videos
# (lo sacas de la URL: https://drive.google.com/drive/folders/ESTE_ID)
DRIVE_FOLDER_ID=

# Puerto del servidor (para despliegue)
PORT=8000
